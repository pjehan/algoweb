Algorithme expressions

Variables
  a : réel
  b : réel
  r : réel
  max_ : entier
  mot : chaîne
  T : liste d'entiers
  k : entier
Début
  T ← []
  a ← randint(1, 6)
  b ← a^2 mod 7
  r ← sqrt(a) + sqrt(b) * pi
  r ← round(r, 2)
  max_ ← floor(r) + round(r / 3)
  mot ← "Valeur : " + str(a)
  mot ← mot[2:5] + mot[0] + chr(65)
  Afficher len(mot) + ord(mot[1]) ↵
  Afficher str(a) + str(b) ↵
  Si a = b ou non a ≠ 1 et b ≤ 3 ou a ≥ b alors
    a ← -(a + 1) * (b - 2) / -3
  FinSi
  T[0] ← 4
  T[1] ← 1
  T[2] ← 9
  Afficher sum(T[0:3]) + sum(T[0:k + 1]) / len(T[0:k + 1]) ↵
  Afficher ALGOBOX_ECART_TYPE(T, 0, 2) ↵
  Afficher a^b ↵
  // [AlgoBox, non converti] AFFICHERCALCUL mot.toUpperCase()
  // [AlgoBox, non converti] AFFICHERCALCUL (a+
  Pour k de 1 à floor(a / 2) faire
    a ← a - 1
  FinPour
  // [AlgoBox, non converti] TRUC
Fin
